# PhotoPro Environment Variables Template
# Copy this file to .env.local to configure your local development environment

# Application Metadata
VITE_APP_TITLE=PhotoPro
VITE_APP_DESCRIPTION=Professional Creative Photo & Video Editing Platform
VITE_APP_VERSION=1.0.0

# Client Security Limits
VITE_MAX_IMAGE_UPLOAD_MB=50
VITE_MAX_VIDEO_UPLOAD_MB=500
VITE_MAX_PDF_UPLOAD_MB=100

# Feature Toggles
VITE_ENABLE_AI_BACKGROUND_REMOVAL=true
VITE_ENABLE_4K_EXPORT=true
VITE_ENABLE_DEBUG_LOGS=false
